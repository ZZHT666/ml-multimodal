__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# generated synthetic data (versioned by DVC: data/synthetic.dvc)
data/synthetic/

# model checkpoints and run outputs (versioned by DVC: dvc.yaml / dvc.lock)
outputs/*
!outputs/*.dvc
!outputs/.gitignore
!outputs/metrics.json
!outputs/flickr30k/
outputs/flickr30k/*
!outputs/flickr30k/.gitignore
!outputs/flickr30k/metrics.json

# MLflow local tracking store
mlruns/
mlflow.db
mlartifacts/

# latency benchmark reports
benchmarks/

# cached backbone features (stored in GCS, tracked by DVC via `dvc import-url`)
features/*
!features/*.dvc
!features/.gitignore
